// expert1c 03.10.2026 Обработка заявок на выполнение

// Для заявок с заданным исполнителем (отбор по реквизиту адресации АдресацияИсполнитель,
// колонка "Исполнитель" в списке заявок) во всех статусах устанавливает вид работ,
// а у заявок в статусах СтатусПринята и СтатусНазначена очищает исполнителя.
// Исполнитель не очищается у заявок в статусе СтатусНазначена, по которым уже есть ответ
// (в закладке "Письма" больше одного письма).
// Запись выполняется без обработчиков ПередЗаписью задачи, чтобы не рассылать
// уведомления и не создавать исходящие письма.
//
// Возвращаемое значение:
//  Структура - Обработано, ИсполнительОчищен, ПропущеноСОтветом, Ошибок.
//
Функция ВыполнитьОбработку() Экспорт
	
	Результат = Новый Структура("Обработано, ИсполнительОчищен, ПропущеноСОтветом, Ошибок", 0, 0, 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявки.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(Письма.НомерСтроки) КАК КоличествоПисем
	|ИЗ
	|	Задача.ЗаявкаНаВыполнение КАК Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗаявкаНаВыполнение.Письма КАК Письма
	|		ПО Заявки.Ссылка = Письма.Ссылка
	|ГДЕ
	|	Заявки.АдресацияИсполнитель = &Исполнитель
	|	И НЕ Заявки.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Заявки.Ссылка";
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	ТаблицаЗаявок = Запрос.Выполнить().Выгрузить();
	
	ПустойИсполнитель = Справочники.Пользователи.ПустаяСсылка();
	
	Для Каждого СтрокаЗаявки Из ТаблицаЗаявок Цикл
		
		Попытка
			ЗаявкаОбъект = СтрокаЗаявки.Ссылка.ПолучитьОбъект();
			Изменена = Ложь;
			
			// Обработчик ПередЗаписью при загрузке не выполняется, но ПриЗаписи читает это свойство.
			ЗаявкаОбъект.ДополнительныеСвойства.Вставить("Изменения", Новый Структура("ЕстьИзменения", Ложь));
			ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
			
			Если ЗначениеЗаполнено(ВидРабот) И ЗаявкаОбъект.ВидРабот <> ВидРабот Тогда
				ЗаявкаОбъект.ВидРабот = ВидРабот;
				Изменена = Истина;
			КонецЕсли;
			
			Очищать = ЗначениеЗаполнено(ЗаявкаОбъект.Статус)
				И (ЗаявкаОбъект.Статус = СтатусПринята ИЛИ ЗаявкаОбъект.Статус = СтатусНазначена);
			
			Если Очищать И ЗаявкаОбъект.Статус = СтатусНазначена И СтрокаЗаявки.КоличествоПисем > 1 Тогда
				Очищать = Ложь;
				Результат.ПропущеноСОтветом = Результат.ПропущеноСОтветом + 1;
			КонецЕсли;
			
			Если Очищать Тогда
				ЗаявкаОбъект.АдресацияИсполнитель = ПустойИсполнитель;
				Изменена = Истина;
				Результат.ИсполнительОчищен = Результат.ИсполнительОчищен + 1;
			КонецЕсли;
			
			Если Изменена Тогда
				ЗаявкаОбъект.Записать();
				Результат.Обработано = Результат.Обработано + 1;
			КонецЕсли;
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			ЗаписьЖурналаРегистрации("Обработка заявок на выполнение",
				УровеньЖурналаРегистрации.Ошибка, Метаданные.Задачи.ЗаявкаНаВыполнение, СтрокаЗаявки.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает исполнителя (реквизит Исполнитель обработки) в заявки, у которых исполнитель
// не указан, статус СтатусПринята или СтатусНазначена и в закладке "Письма" больше одного письма.
//
// Возвращаемое значение:
//  Структура - Найдено, Возвращено, Ошибок.
//
Функция ВернутьИсполнителяПоЗаявкамСОтветом() Экспорт
	
	Результат = Новый Структура("Найдено, Возвращено, Ошибок", 0, 0, 0);
	
	Статусы = Новый Массив;
	Если ЗначениеЗаполнено(СтатусПринята) Тогда
		Статусы.Добавить(СтатусПринята);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтатусНазначена) Тогда
		Статусы.Добавить(СтатусНазначена);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗаявкаНаВыполнение КАК Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Задача.ЗаявкаНаВыполнение.Письма КАК Письма
	|		ПО Заявки.Ссылка = Письма.Ссылка
	|ГДЕ
	|	Заявки.АдресацияИсполнитель = &ПустойИсполнитель
	|	И Заявки.Статус В(&Статусы)
	|	И НЕ Заявки.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Заявки.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Письма.НомерСтроки) > 1";
	Запрос.УстановитьПараметр("ПустойИсполнитель", Справочники.Пользователи.ПустаяСсылка());
	Запрос.УстановитьПараметр("Статусы", Статусы);
	МассивЗаявок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Результат.Найдено = МассивЗаявок.Количество();
	
	Для Каждого Заявка Из МассивЗаявок Цикл
		
		Попытка
			ЗаявкаОбъект = Заявка.ПолучитьОбъект();
			ЗаявкаОбъект.ДополнительныеСвойства.Вставить("Изменения", Новый Структура("ЕстьИзменения", Ложь));
			ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
			ЗаявкаОбъект.АдресацияИсполнитель = Исполнитель;
			ЗаявкаОбъект.Записать();
			Результат.Возвращено = Результат.Возвращено + 1;
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			ЗаписьЖурналаРегистрации("Обработка заявок на выполнение",
				УровеньЖурналаРегистрации.Ошибка, Метаданные.Задачи.ЗаявкаНаВыполнение, Заявка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
// Конец expert1c
