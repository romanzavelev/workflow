// expert1c 03.10.2026 Обработка заявок на выполнение
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Значения, выбранные при прошлом запуске
	Сохраненные = ХранилищеОбщихНастроек.Загрузить("expert1cОбработкаЗаявок", "Параметры");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		Для Каждого Элемент Из Сохраненные Цикл
			Если ЗначениеЗаполнено(Элемент.Значение) Тогда
				Объект[Элемент.Ключ] = Элемент.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Исполнитель) Тогда
		Объект.Исполнитель = Справочники.Пользователи.НайтиПоНаименованию("Завелев Роман Ильич", Истина);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидРабот) Тогда
		Объект.ВидРабот = Справочники.ВидыРабот.НайтиПоНаименованию("Поддержка 1С", Истина);
		Если НЕ ЗначениеЗаполнено(Объект.ВидРабот) Тогда
			Объект.ВидРабот = Справочники.ВидыРабот.НайтиПоНаименованию("Поддержка 1с", Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СтатусПринята) Тогда
		Объект.СтатусПринята = Справочники.СтатусЗадачНаВыполнение.Принята;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СтатусНазначена) Тогда
		Объект.СтатусНазначена = Справочники.СтатусЗадачНаВыполнение.НайтиПоНаименованию("Назначена", Истина);
		Если НЕ ЗначениеЗаполнено(Объект.СтатусНазначена) Тогда
			Объект.СтатусНазначена = Справочники.СтатусЗадачНаВыполнение.НайтиПоНаименованию("Назначено", Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗаявки(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Исполнитель) Тогда
		ПоказатьПредупреждение(, "Укажите исполнителя, по которому нужно отобрать заявки.");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Будут изменены все заявки на выполнение с исполнителем «" + Объект.Исполнитель
		+ "»: вид работ станет «" + Объект.ВидРабот + "», у заявок в статусах «"
		+ Объект.СтатусПринята + "» и «" + Объект.СтатусНазначена + "» исполнитель будет очищен. Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбработатьЗаявкиЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗаявкиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ВыполнитьНаСервере();
	ПоказатьПредупреждение(, "Обработано заявок: " + Результат.Обработано
		+ Символы.ПС + "Исполнитель очищен: " + Результат.ИсполнительОчищен
		+ Символы.ПС + "Пропущено (в статусе Назначена есть ответ): " + Результат.ПропущеноСОтветом
		+ Символы.ПС + "Ошибок: " + Результат.Ошибок);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьНаСервере()
	
	Сохраненные = Новый Структура("Исполнитель, ВидРабот, СтатусПринята, СтатусНазначена");
	ЗаполнитьЗначенияСвойств(Сохраненные, Объект);
	ХранилищеОбщихНастроек.Сохранить("expert1cОбработкаЗаявок", "Параметры", Сохраненные);
	
	Возврат РеквизитФормыВЗначение("Объект").ВыполнитьОбработку();
	
КонецФункции
&НаКлиенте
Процедура ВернутьИсполнителя(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Исполнитель) Тогда
		ПоказатьПредупреждение(, "Укажите исполнителя, которого нужно вернуть в заявки.");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "В заявки без исполнителя в статусах «" + Объект.СтатусПринята + "» и «" + Объект.СтатусНазначена
		+ "», по которым в закладке ""Письма"" больше одного письма, будет возвращён исполнитель «"
		+ Объект.Исполнитель + "». Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ВернутьИсполнителяЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьИсполнителяЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ВернутьИсполнителяНаСервере();
	ПоказатьПредупреждение(, "Найдено заявок с ответом: " + Результат.Найдено
		+ Символы.ПС + "Исполнитель возвращён: " + Результат.Возвращено
		+ Символы.ПС + "Ошибок: " + Результат.Ошибок);
	
КонецПроцедуры

&НаСервере
Функция ВернутьИсполнителяНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ВернутьИсполнителяПоЗаявкамСОтветом();
	
КонецФункции

&НаКлиенте
Процедура ПеревестиВПринятые(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.СтатусНазначена) ИЛИ НЕ ЗначениеЗаполнено(Объект.СтатусПринята) Тогда
		ПоказатьПредупреждение(, "Укажите статусы «Принята» и «Назначена».");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Заявки в статусе «" + Объект.СтатусНазначена + "» без исполнителя будут переведены в статус «"
		+ Объект.СтатусПринята + "». Продолжить?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПеревестиВПринятыеЗавершение", ЭтотОбъект), ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиВПринятыеЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПеревестиВПринятыеНаСервере();
	ПоказатьПредупреждение(, "Найдено заявок: " + Результат.Найдено
		+ Символы.ПС + "Переведено в статус «Принята»: " + Результат.Изменено
		+ Символы.ПС + "Ошибок: " + Результат.Ошибок);
	
КонецПроцедуры

&НаСервере
Функция ПеревестиВПринятыеНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ПеревестиВПринятыеЗаявкиБезИсполнителя();
	
КонецФункции
