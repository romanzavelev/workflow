// Находит участника портала по токену сессии. Токен передается в своем заголовке, а не в Authorization:
// тот может быть занят аутентификацией публикации.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос
//
// Возвращаемое значение:
//  Структура, Неопределено - участник портала; Неопределено, если токен неверный или просрочен
//
Функция УчастникЗапроса(Запрос)

	Токен = "";
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) = "x-portal-token" Тогда
			Токен = Заголовок.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат expert1cПорталЗаявок.УчастникПоТокену(Токен);

КонецФункции

Функция ПрочитатьТело(Запрос)

	Результат = Новый Соответствие;

	Попытка
		Текст = Запрос.ПолучитьТелоКакСтроку();
		Если СтрДлина(Текст) > 30000 Тогда
			Возврат Результат;
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Результат = Данные;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПараметрТела(Данные, Имя)

	Значение = Данные.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), Значение, "");

КонецФункции

Функция ОтветJSON(Результат)

	Ответ = Новый HTTPСервисОтвет(Результат.Код);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результат.Данные);

	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

Функция ОтветНеАвторизован()

	Возврат ОтветJSON(expert1cПорталЗаявок.Ошибка(401, "Требуется вход."));

КонецФункции

Функция ОтветОшибкиСервера(ИнформацияОбОшибке)

	ЗаписьЖурналаРегистрации("Портал заявок", УровеньЖурналаРегистрации.Ошибка, , ,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	Возврат ОтветJSON(expert1cПорталЗаявок.Ошибка(500, "Внутренняя ошибка сервера. Повторите позже."));

КонецФункции

