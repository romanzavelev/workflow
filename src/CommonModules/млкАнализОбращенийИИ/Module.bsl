// Общий модуль: млкАнализОбращенийИИ
// Свойства: Сервер = Истина

#Область ПрограммныйИнтерфейс

// Формирует "человечный" ответ по обращению с учётом ИИ-анализа и очереди задач,
// дописывает его в уже созданное ИсходящееПисьмо и переводит в статус "готово к отправке".
Процедура СформироватьИОтправитьЧеловечныйОтвет(Знач ИсходящееПисьмоСсылка, Знач ТекстОбращения,
	Знач ИмяАдресата, Знач НомерЗадачи, Знач Исполнитель) Экспорт

	ТекстОтвета = "";

	Попытка
		РезультатАнализа = ПроанализироватьОбращениеИИ(ТекстОбращения);
		Очередь = ПолучитьОчередьЗадач(Исполнитель);
		ОриентировочныйСрок = РассчитатьОриентировочныйСрок(РезультатАнализа.Категория, РезультатАнализа.Приоритет, Очередь);
		ТекстОтвета = СформироватьТекстЧеловечногоПисьма(ИмяАдресата, РезультатАнализа, ОриентировочныйСрок);
	Исключение
		// ИИ недоступен/ошибка разбора — не блокируем отправку, уходит нейтральный текст
		ЗаписьЖурналаРегистрации("АнализОбращенийИИ", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстОтвета = "Ваше обращение принято в работу.";
	КонецПопытки;

	// Технический футер — фиксированный, ИИ его не формирует
	ТекстОтвета = ТекстОтвета + Символы.ПС + Символы.ПС +
		"----" + Символы.ПС +
		"Номер вашей заявки: [#" + НомерЗадачи + "]. Отвечая на это письмо, пожалуйста, " +
		"сохраняйте тему без изменений — так ответ автоматически попадёт в вашу заявку.";

	ИсходящееПисьмоОбъект = ИсходящееПисьмоСсылка.ПолучитьОбъект();
	ИсходящееПисьмоОбъект.ТекстХранилище = Новый ХранилищеЗначения(ТекстОтвета);
	ИсходящееПисьмоОбъект.ПодготовленоКОтправке = ТекущаяДата();
	ИсходящееПисьмоОбъект.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает отображаемое имя отправителя из адресата письма.
// Допущение: у объекта "Адресат" есть поле Представление (как у ВстроеннаяПочтаСервер).
// Если у вас это поле называется иначе — замените обращение ниже.
Функция ИзвлечьИмяОтправителя(Знач АдресатОтправителя)

	Попытка
		Если ЗначениеЗаполнено(АдресатОтправителя.Представление) Тогда
			Возврат АдресатОтправителя.Представление;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Фолбэк — часть адреса до "@"
	Адрес = СокрЛП(АдресатОтправителя.Адрес);
	ПозицияСобаки = Найти(Адрес, "@");
	Если ПозицияСобаки > 0 Тогда
		Возврат Лев(Адрес, ПозицияСобаки - 1);
	КонецЕсли;

	Возврат "Уважаемый клиент";

КонецФункции

// Вызывает GigaChat, разбирает JSON-ответ вида {"Категория","Приоритет","Резюме"}
Функция ПроанализироватьОбращениеИИ(Знач ТекстОбращения)

	СистемныйПромпт =
		"Ты — ассистент службы поддержки. Проанализируй текст обращения пользователя. " +
		"Определи Категорию (одно слово: Техническое/Доступы/Консультация/Прочее), " +
		"Приоритет (Высокий/Средний/Низкий) и составь Резюме заявки (не более 200 символов). " +
		"Ответь СТРОГО в формате JSON без пояснений: " +
		"{""Категория"": ""..."", ""Приоритет"": ""..."", ""Резюме"": ""...""}";

	ОтветИИ = ВызватьGigaChat(СистемныйПромпт, ТекстОбращения);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ОтветИИ);
	Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

// Генерирует финальный текст письма от лица "живого" сотрудника
Функция СформироватьТекстЧеловечногоПисьма(Знач ИмяАдресата, Знач РезультатАнализа, Знач ОриентировочныйСрок)

	СрокСтрокой = Формат(ОриентировочныйСрок, "ДЛФ=DD"); // передаём как ориентир, не как точную выдачу

	СистемныйПромпт =
		"Ты — сотрудник службы поддержки, отвечаешь на обращение пользователя по электронной почте. " +
		"Пиши от первого лица, живым деловым языком, без канцеляризмов и без упоминания того, " +
		"что ответ подготовлен автоматически или искусственным интеллектом. " +
		"Не используй фразы 'на основе анализа', 'система определила', 'автоматически' и подобные. " +
		"Структура: 1) короткое обращение по имени и подтверждение, что заявка принята в работу; " +
		"2) одна фраза, показывающая, что вник в суть обращения (перефразируй своими словами, " +
		"не копируй дословно текст пользователя); " +
		"3) реалистичный срок решения — не как точную дату, а как обычно говорят люди " +
		"('до конца этой недели', 'в течение 2-3 рабочих дней'), опираясь на переданный ориентир; " +
		"4) короткая вежливая концовка без подписи (подпись добавим отдельно). " +
		"Объём — 4-6 предложений, обычный текст без markdown.";

	ВходныеДанные =
		"Имя получателя: " + ИмяАдресата + Символы.ПС +
		"Резюме сути обращения: " + РезультатАнализа.Резюме + Символы.ПС +
		"Категория: " + РезультатАнализа.Категория + Символы.ПС +
		"Приоритет: " + РезультатАнализа.Приоритет + Символы.ПС +
		"Ориентировочная дата решения (перефразируй словами, не выводи как есть): " + СрокСтрокой;

	Возврат ВызватьGigaChat(СистемныйПромпт, ВходныеДанные);

КонецФункции

// Считает количество незакрытых задач у исполнителя
Функция ПолучитьОчередьЗадач(Знач Исполнитель)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоЗадач
	|ИЗ
	|	Задача.ЗаявкаНаВыполнение КАК ЗаявкаНаВыполнение
	|ГДЕ
	|	ЗаявкаНаВыполнение.Статус <> ЗНАЧЕНИЕ(Справочник.СтатусЗадачНаВыполнение.Выполнена)
	|	И ЗаявкаНаВыполнение.АдресацияИсполнитель = &Исполнитель
	|	И ЗаявкаНаВыполнение.Выполнена = ЛОЖЬ";

	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоЗадач;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Рассчитывает ориентировочный срок с учётом категории, приоритета и текущей очереди
Функция РассчитатьОриентировочныйСрок(Знач Категория, Знач Приоритет, Знач Очередь)

	БазовыеСроки = Новый Соответствие;
	БазовыеСроки.Вставить("Техническое", 8);
	БазовыеСроки.Вставить("Доступы", 4);
	БазовыеСроки.Вставить("Консультация", 2);
	БазовыеСроки.Вставить("Прочее", 24);

	БазовыйСрокЧасов = БазовыеСроки[Категория];
	Если БазовыйСрокЧасов = Неопределено Тогда
		БазовыйСрокЧасов = 24;
	КонецЕсли;

	СреднееВремяНаЗадачуЧасов = 2; // можно считать динамически как факт. среднее время закрытия за период

	КоэффициентПриоритета = ?(Приоритет = "Высокий", 0.5, ?(Приоритет = "Низкий", 1.5, 1));

	ИтоговыйСрокЧасов = (БазовыйСрокЧасов + Очередь * СреднееВремяНаЗадачуЧасов) * КоэффициентПриоритета;

	Возврат ТекущаяДата() + ИтоговыйСрокЧасов * 3600;

КонецФункции

// Вызов GigaChat API (Сбер) — HTTP REST
Функция ВызватьGigaChat(Знач СистемныйПромпт, Знач ТекстПользователя)

	ТокенДоступа = ПолучитьТокенGigaChat();

	Соединение = Новый HTTPСоединение("gigachat.devices.sberbank.ru", 443, , , , 30,
		Новый ЗащищенноеСоединениеOpenSSL());

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + ТокенДоступа);

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("model", "GigaChat");
	ТелоЗапроса.Вставить("temperature", 0.3);

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", СистемныйПромпт));
	Сообщения.Добавить(Новый Структура("role, content", "user", ТекстПользователя));
	ТелоЗапроса.Вставить("messages", Сообщения);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	СтрокаЗапроса = ЗаписьJSON.Закрыть();

	HTTPЗапрос = Новый HTTPЗапрос("/api/v1/chat/completions", Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса);

	HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);

	Если HTTPОтвет.КодСостояния <> 200 Тогда
		ВызватьИсключение "Ошибка GigaChat: " + HTTPОтвет.КодСостояния + " " + HTTPОтвет.ПолучитьТелоКакСтроку();
	КонецЕсли;

	ЧтениеОтвета = Новый ЧтениеJSON;
	ЧтениеОтвета.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
	СтруктураОтвета = ПрочитатьJSON(ЧтениеОтвета, Истина);
	ЧтениеОтвета.Закрыть();

	Возврат СтруктураОтвета.choices[0].message.content;

КонецФункции

// OAuth-токен GigaChat (кэшировать в константе/регистре сведений на ~30 мин в реальном коде)
Функция ПолучитьТокенGigaChat()

	СекретныйКлюч = Константы.GigaChat_AuthorizationKey.Получить();

	Соединение = Новый HTTPСоединение("ngw.devices.sberbank.ru", 9443, , , , 30,
		Новый ЗащищенноеСоединениеOpenSSL());

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Authorization", "Basic " + СекретныйКлюч);
	Заголовки.Вставить("RqUID", Строка(Новый УникальныйИдентификатор));

	HTTPЗапрос = Новый HTTPЗапрос("/api/v2/oauth", Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки("scope=GIGACHAT_API_CORP");

	HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);

	ЧтениеОтвета = Новый ЧтениеJSON;
	ЧтениеОтвета.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
	СтруктураОтвета = ПрочитатьJSON(ЧтениеОтвета, Истина);
	ЧтениеОтвета.Закрыть();

	Возврат СтруктураОтвета.access_token;

КонецФункции

#КонецОбласти