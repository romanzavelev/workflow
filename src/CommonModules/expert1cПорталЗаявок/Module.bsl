// expert1c 03.10.2026 Портал заявок для внешних пользователей
// Регистрация по почте, вход, создание и просмотр своих заявок.
// Вызывается из HTTP-сервиса expert1cПорталЗаявок. Данные читаются и пишутся в привилегированном режиме,
// поэтому каждая функция сама проверяет, что заявка принадлежит участнику портала.
// Пароль задается только после подтверждения почты по ссылке из письма (так же работает восстановление пароля).

#Область ПрограммныйИнтерфейс

// Возвращает организации, которые можно выбрать при регистрации.
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: organizations - Массив структур id, name)
//
Функция Организации() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Список = Новый Массив;
	Для Каждого Организация Из ДоступныеОрганизации() Цикл
		Список.Добавить(Новый Структура("id,name", ИдентификаторСсылки(Организация), Организация.Наименование));
	КонецЦикла;

	Возврат Ответ(200, Новый Структура("organizations", Список));

КонецФункции

// Начинает регистрацию (или восстановление пароля): отправляет на почту ссылку для установки пароля.
// Ответ одинаковый для новых и уже зарегистрированных адресов, чтобы нельзя было перебирать адреса.
//
// Параметры:
//  Email - Строка - почта, она же логин
//  Имя - Строка - имя участника
//  ИдОрганизации - Строка - идентификатор выбранной организации (пусто - организация по умолчанию)
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: message)
//
Функция Зарегистрировать(Знач Email, Знач Имя, Знач ИдОрганизации) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Email = НормализоватьEmail(Email);
	Имя = Лев(СокрЛП(Имя), 100);

	Если НЕ EmailКорректен(Email) Тогда
		Возврат Ошибка(400, "Укажите корректный адрес электронной почты.");
	КонецЕсли;
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ошибка(400, "Укажите имя.");
	КонецЕсли;
	Организация = ОрганизацияДляРегистрации(ИдОрганизации);
	Если Организация = Неопределено Тогда
		Возврат Ошибка(400, "Организация не выбрана или недоступна.");
	КонецЕсли;

	Участник = Справочники.expert1cУчастникиПортала.НайтиПоРеквизиту("Email", Email);
	Если Участник.Пустая() Тогда
		Объект = Справочники.expert1cУчастникиПортала.СоздатьЭлемент();
		Объект.Email = Email;
		Объект.Наименование = Имя;
		Объект.Организация = Организация;
		Объект.Адресат = ВстроеннаяПочтаСервер.ПолучитьПочтовогоАдресата(Email, Имя);
	Иначе
		Объект = Участник.ПолучитьОбъект();
		Если НЕ Объект.Подтвержден Тогда
			Объект.Наименование = Имя;
			Объект.Организация = Организация;
		КонецЕсли;
	КонецЕсли;

	ТекДата = ТекущаяДатаСеанса();

	// Не чаще одного письма в 5 минут на адрес.
	Если ЗначениеЗаполнено(Объект.ПодтверждениеВыслано) И ТекДата < Объект.ПодтверждениеВыслано + 300 Тогда
		Возврат Ответ(200, Новый Структура("message", СообщениеОтправлено()));
	КонецЕсли;

	Токен = НовыйТокен();
	Объект.ТокенПодтвержденияХеш = ХешТокена(Токен);
	Объект.ПодтверждениеДействуетДо = ТекДата + 86400;
	Объект.ПодтверждениеВыслано = ТекДата;
	Объект.Записать();

	Если НЕ ОтправитьПисьмоСоСсылкой(Объект.Адресат, Объект.Наименование, Токен) Тогда
		Возврат Ошибка(500, "Не удалось отправить письмо. Обратитесь в поддержку.");
	КонецЕсли;

	Возврат Ответ(200, Новый Структура("message", СообщениеОтправлено()));

КонецФункции

// Завершает регистрацию: по токену из письма подтверждает почту и задает пароль.
//
// Параметры:
//  Токен - Строка - токен из ссылки в письме
//  Пароль - Строка - новый пароль (не короче 8 символов)
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: token, name при успехе; message при ошибке)
//
Функция УстановитьПароль(Знач Токен, Знач Пароль) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ПустаяСтрока(Токен) Тогда
		Возврат Ошибка(400, "Ссылка недействительна или устарела.");
	КонецЕсли;
	Если СтрДлина(Пароль) < 8 Тогда
		Возврат Ошибка(400, "Пароль должен быть не короче 8 символов.");
	КонецЕсли;
	Если СтрДлина(Пароль) > 100 Тогда
		Возврат Ошибка(400, "Пароль слишком длинный.");
	КонецЕсли;

	Участник = Справочники.expert1cУчастникиПортала.НайтиПоРеквизиту("ТокенПодтвержденияХеш", ХешТокена(Токен));
	Если Участник.Пустая() Тогда
		Возврат Ошибка(400, "Ссылка недействительна или устарела.");
	КонецЕсли;

	Объект = Участник.ПолучитьОбъект();
	Если ТекущаяДатаСеанса() > Объект.ПодтверждениеДействуетДо Тогда
		Возврат Ошибка(400, "Ссылка недействительна или устарела.");
	КонецЕсли;

	Объект.Соль = НовыйТокен();
	Объект.ХешПароля = ХешПароля(Пароль, Объект.Соль);
	Объект.Подтвержден = Истина;
	Объект.ТокенПодтвержденияХеш = "";
	Объект.ПодтверждениеДействуетДо = Дата(1, 1, 1);
	Объект.ПопыткиВхода = 0;
	Объект.БлокировкаДо = Дата(1, 1, 1);

	ТокенСессии = НоваяСессия(Объект);
	Объект.Записать();

	Возврат Ответ(200, Новый Структура("token,name", ТокенСессии, Объект.Наименование));

КонецФункции

// Выполняет вход по почте и паролю.
//
// Параметры:
//  Email - Строка - почта (логин)
//  Пароль - Строка - пароль
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: token, name при успехе; message при ошибке)
//
Функция Войти(Знач Email, Знач Пароль) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ОшибкаВхода = Ошибка(401, "Неверный адрес почты или пароль.");

	Участник = Справочники.expert1cУчастникиПортала.НайтиПоРеквизиту("Email", НормализоватьEmail(Email));
	Если Участник.Пустая() Тогда
		Возврат ОшибкаВхода;
	КонецЕсли;

	Объект = Участник.ПолучитьОбъект();
	Если НЕ Объект.Подтвержден ИЛИ ПустаяСтрока(Объект.ХешПароля) Тогда
		Возврат ОшибкаВхода;
	КонецЕсли;

	ТекДата = ТекущаяДатаСеанса();
	Если Объект.БлокировкаДо > ТекДата Тогда
		Возврат Ошибка(429, "Слишком много неудачных попыток. Повторите вход через 15 минут.");
	КонецЕсли;

	Если Объект.ХешПароля <> ХешПароля(Пароль, Объект.Соль) Тогда
		Объект.ПопыткиВхода = Объект.ПопыткиВхода + 1;
		Если Объект.ПопыткиВхода >= 5 Тогда
			Объект.ПопыткиВхода = 0;
			Объект.БлокировкаДо = ТекДата + 900;
		КонецЕсли;
		Объект.Записать();
		Возврат ОшибкаВхода;
	КонецЕсли;

	Объект.ПопыткиВхода = 0;
	ТокенСессии = НоваяСессия(Объект);
	Объект.Записать();

	Возврат Ответ(200, Новый Структура("token,name", ТокенСессии, Объект.Наименование));

КонецФункции

// Находит участника по токену сессии.
//
// Параметры:
//  Токен - Строка - токен сессии из заголовка запроса
//
// Возвращаемое значение:
//  Структура, Неопределено - Адресат, Организация, Имя; Неопределено, если токен неверный или просрочен
//
Функция УчастникПоТокену(Знач Токен) Экспорт

	Если ПустаяСтрока(Токен) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Участник = Справочники.expert1cУчастникиПортала.НайтиПоРеквизиту("ТокенСессииХеш", ХешТокена(Токен));
	Если Участник.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Участник.Подтвержден ИЛИ ТекущаяДатаСеанса() > Участник.ТокенСессииДействуетДо Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Адресат,Организация,Имя", Участник.Адресат, Участник.Организация, Участник.Наименование);

КонецФункции

// Создает заявку от имени участника портала. Заявка попадает в тот же список, что и заявки из писем.
//
// Параметры:
//  Участник - Структура - результат УчастникПоТокену
//  Тема - Строка - тема заявки
//  Текст - Строка - описание
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: number при успехе; message при ошибке)
//
Функция СоздатьЗаявку(Участник, Знач Тема, Знач Текст) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Тема = Лев(СокрЛП(Тема), 150);
	Текст = Лев(СокрЛП(Текст), 10000);
	Если ПустаяСтрока(Тема) ИЛИ ПустаяСтрока(Текст) Тогда
		Возврат Ошибка(400, "Заполните тему и описание заявки.");
	КонецЕсли;

	// Защита от флуда: не больше 20 заявок в час от одного участника.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Задача.ЗаявкаНаВыполнение КАК Заявки
	|ГДЕ
	|	Заявки.АдресацияИнициатор = &Адресат
	|	И Заявки.Дата >= &Граница";
	Запрос.УстановитьПараметр("Адресат", Участник.Адресат);
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 3600);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество >= 20 Тогда
		Возврат Ошибка(429, "Слишком много заявок за последний час. Повторите позже.");
	КонецЕсли;

	Заявка = Задачи.ЗаявкаНаВыполнение.СоздатьЗадачу();
	Заявка.Дата = ТекущаяДатаСеанса();
	Заявка.Тема = Тема;
	Заявка.Наименование = Лев(Тема, 25);
	Заявка.Содержание = Текст;
	Заявка.АдресацияИсполнитель = Константы.ИсполнительЗадачиПоУмолчанию.Получить();
	Заявка.Статус = Справочники.СтатусЗадачНаВыполнение.Принята;
	Заявка.АдресацияИнициатор = Участник.Адресат;
	Заявка.Организация = Участник.Организация;

	Получатель = Заявка.Получатели.Добавить();
	Получатель.Адресат = Участник.Адресат;
	Получатель.Оповещать = Истина;

	Заявка.Записать();

	Возврат Ответ(200, Новый Структура("number", Заявка.Номер));

КонецФункции

// Возвращает заявки участника (последние 200).
//
// Параметры:
//  Участник - Структура - результат УчастникПоТокену
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: requests - Массив структур number, date, subject, status, done)
//
Функция СписокЗаявок(Участник) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Заявки.Номер КАК Номер,
	|	Заявки.Дата КАК Дата,
	|	Заявки.Тема КАК Тема,
	|	Статусы.Наименование КАК Статус,
	|	Заявки.Выполнена КАК Выполнена
	|ИЗ
	|	Задача.ЗаявкаНаВыполнение КАК Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатусЗадачНаВыполнение КАК Статусы
	|		ПО Заявки.Статус = Статусы.Ссылка
	|ГДЕ
	|	Заявки.АдресацияИнициатор = &Адресат
	|	И НЕ Заявки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заявки.Дата УБЫВ";
	Запрос.УстановитьПараметр("Адресат", Участник.Адресат);
	Выборка = Запрос.Выполнить().Выбрать();

	Список = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Список.Добавить(Новый Структура("number,date,subject,status,done",
			Выборка.Номер, ПредставлениеДаты(Выборка.Дата), Выборка.Тема,
			СтатусДляПортала(Выборка.Статус, Выборка.Выполнена), Выборка.Выполнена));
	КонецЦикла;

	Возврат Ответ(200, Новый Структура("requests", Список));

КонецФункции

// Возвращает одну заявку участника с перепиской.
//
// Параметры:
//  Участник - Структура - результат УчастникПоТокену
//  Номер - Строка - номер заявки
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: number, date, subject, text, status, done, messages)
//
Функция ПолучитьЗаявку(Участник, Знач Номер) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Номер = Прав("000000000" + СокрЛП(Номер), 9);
	Ссылка = Задачи.ЗаявкаНаВыполнение.НайтиПоНомеру(Номер);
	// Чужая и несуществующая заявки неразличимы для вызывающего.
	Если Ссылка.Пустая() Тогда
		Возврат Ошибка(404, "Заявка не найдена.");
	КонецЕсли;
	Заявка = Ссылка.ПолучитьОбъект();
	Если Заявка.ПометкаУдаления ИЛИ Заявка.АдресацияИнициатор <> Участник.Адресат Тогда
		Возврат Ошибка(404, "Заявка не найдена.");
	КонецЕсли;

	ТекстЗаявки = СокрЛП(Заявка.Содержание);

	// Только письма: внутренние комментарии исполнителей (ВнутренниеКоментарии) участнику не показываются.
	Сообщения = Новый Массив;
	КоличествоПисем = Заявка.Письма.Количество();
	Для Индекс = Макс(0, КоличествоПисем - 50) По КоличествоПисем - 1 Цикл
		Письмо = Заявка.Письма[Индекс].Письмо;
		Если Письмо.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Исходящее = ТипЗнч(Письмо) = Тип("ДокументСсылка.ИсходящееПисьмо");
		Если Исходящее Тогда
			Текст = ТекстИзХранилища(Письмо.ТекстХранилище);
		Иначе
			Текст = ТекстИзХранилища(Письмо.ТекстПисьмаПростойТекстХранилище);
		КонецЕсли;
		Текст = СокрЛП(Текст);
		// Первое письмо заявки, созданной из почты, совпадает с описанием.
		Если НЕ Исходящее И Текст = ТекстЗаявки Тогда
			Продолжить;
		КонецЕсли;
		Сообщения.Добавить(Новый Структура("outgoing,date,text", Исходящее, ПредставлениеДаты(Письмо.Дата), Лев(Текст, 5000)));
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("number", Заявка.Номер);
	Данные.Вставить("date", ПредставлениеДаты(Заявка.Дата));
	Данные.Вставить("subject", Заявка.Тема);
	Данные.Вставить("text", ТекстЗаявки);
	Данные.Вставить("status", СтатусДляПортала(Заявка.Статус.Наименование, Заявка.Выполнена));
	Данные.Вставить("done", Заявка.Выполнена);
	Данные.Вставить("messages", Сообщения);

	Возврат Ответ(200, Данные);

КонецФункции

// Формирует результат с ошибкой.
//
// Параметры:
//  Код - Число - код ответа HTTP
//  Сообщение - Строка - текст для пользователя
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: message)
//
Функция Ошибка(Код, Сообщение) Экспорт

	Возврат Ответ(Код, Новый Структура("message", Сообщение));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ответ(Код, Данные)

	Возврат Новый Структура("Код,Данные", Код, Данные);

КонецФункции

Функция СообщениеОтправлено()

	Возврат "Если адрес указан верно, на него отправлено письмо со ссылкой. Ссылка действует 24 часа.";

КонецФункции

Функция НормализоватьEmail(Email)

	Возврат НРег(СокрЛП(Email));

КонецФункции

Функция EmailКорректен(Email)

	Если ПустаяСтрока(Email) ИЛИ СтрДлина(Email) > 100 ИЛИ СтрНайти(Email, " ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Части = СтрРазделить(Email, "@", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(Части[1], ".") > 1 И Прав(Части[1], 1) <> ".";

КонецФункции

Функция НовыйТокен()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")
		+ СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

КонецФункции

Функция ХешТокена(Токен)

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Токен);
	Возврат СтрЗаменить(Строка(Хеш.ХешСумма), " ", "");

КонецФункции

Функция ХешПароля(Пароль, Соль)

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Соль + Пароль);
	Результат = Хеш.ХешСумма;

	Для Счетчик = 1 По 3000 Цикл
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(Результат);
		Хеш.Добавить(Соль);
		Результат = Хеш.ХешСумма;
	КонецЦикла;

	Возврат СтрЗаменить(Строка(Результат), " ", "");

КонецФункции

Функция НоваяСессия(Объект)

	Токен = НовыйТокен();
	Объект.ТокенСессииХеш = ХешТокена(Токен);
	Объект.ТокенСессииДействуетДо = ТекущаяДатаСеанса() + 43200;
	Возврат Токен;

КонецФункции

Функция ДоступныеОрганизации()

	Результат = Новый Массив;
	Организация = Константы.expert1cОрганизацияПортала.Получить();
	Если ЗначениеЗаполнено(Организация) Тогда
		Результат.Добавить(Организация);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОрганизацияДляРегистрации(ИдОрганизации)

	Доступные = ДоступныеОрганизации();
	Если Доступные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ПустаяСтрока(ИдОрганизации) Тогда
		Возврат Доступные[0];
	КонецЕсли;

	Для Каждого Организация Из Доступные Цикл
		Если ИдентификаторСсылки(Организация) = ИдОрганизации Тогда
			Возврат Организация;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ИдентификаторСсылки(Ссылка)

	Возврат Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

Функция ОтправитьПисьмоСоСсылкой(Адресат, Имя, Токен)

	Попытка
		АдресПортала = СокрЛП(Константы.expert1cАдресПортала.Получить());
		Если ПустаяСтрока(АдресПортала) Тогда
			ЗаписьЖурналаРегистрации("Портал заявок", УровеньЖурналаРегистрации.Ошибка, , ,
				"Не заполнена константа ""Адрес портала заявок"".");
			Возврат Ложь;
		КонецЕсли;
		Если Прав(АдресПортала, 1) <> "/" Тогда
			АдресПортала = АдресПортала + "/";
		КонецЕсли;

		ТекДата = ТекущаяДатаСеанса();
		Письмо = Документы.ИсходящееПисьмо.СоздатьДокумент();
		Получатель = Письмо.ПолучателиПисьма.Добавить();
		Получатель.Адресат = Адресат;
		Письмо.Дата = ТекДата;
		Письмо.Тема = "Подтверждение почты на портале заявок";
		Письмо.ТекстХранилище = Новый ХранилищеЗначения(
			"Здравствуйте, " + Имя + "!" + Символы.ПС + Символы.ПС
			+ "Чтобы подтвердить почту и задать пароль на портале заявок, перейдите по ссылке:" + Символы.ПС
			+ АдресПортала + "?token=" + Токен + Символы.ПС + Символы.ПС
			+ "Ссылка действует 24 часа. Если вы не запрашивали регистрацию или смену пароля, просто проигнорируйте это письмо.");
		Письмо.УчетнаяЗапись = Константы.УчетнаяЗаписьПоддержки.Получить();
		Письмо.ПодготовленоКОтправке = ТекДата;
		Письмо.Записать();
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации("Портал заявок", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ТекстИзХранилища(Хранилище)

	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Хранилище.Получить();
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("ФорматированныйДокумент") Тогда
		Возврат Значение.ПолучитьТекст();
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПредставлениеДаты(ЗначениеДаты)

	Возврат Формат(ЗначениеДаты, "ДФ='dd.MM.yyyy HH:mm'");

КонецФункции

Функция СтатусДляПортала(Статус, Выполнена)

	Возврат ?(Выполнена, "Выполнена", Строка(Статус));

КонецФункции

