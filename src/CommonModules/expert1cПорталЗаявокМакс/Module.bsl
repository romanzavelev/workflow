// expert1c 10.11.2026 Портал заявок: вход и уведомления через бота MAX
// Протокол обмена с MAX Bot API (вебхук от MAX и отправка сообщений) и состояние входа.
// Логика участников портала и сессий - в общем модуле expert1cПорталЗаявок.
//
// Схема входа (защищена от подстановки чужой ссылки):
//  1. Страница запрашивает НачатьВход: получает ссылку на бота, проверочный код (показывается на странице)
//     и секрет опроса.
//  2. Пользователь открывает бота по ссылке и нажимает "Начать": MAX шлет событие bot_started с кодом в payload.
//  3. Бот просит отправить проверочный код со страницы. Пользователь отправляет его боту.
//  4. Страница опрашивает ОпросВхода и получает сессию, когда проверочный код введен верно.

#Область ПрограммныйИнтерфейс

// Начинает вход в портал или привязку аккаунта MAX к существующему участнику.
//
// Параметры:
//  Цель - Строка - "вход" или "привязка"
//  Участник - СправочникСсылка.expert1cУчастникиПортала, Неопределено - для привязки: кого привязываем
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: link, code, poll, verify при успехе; message при ошибке)
//
Функция НачатьВход(Знач Цель, Знач Участник = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Ник = СокрЛП(Константы.expert1cМаксНикБота.Получить());
	Если ПустаяСтрока(Ник) ИЛИ ПустаяСтрока(Константы.expert1cМаксТокенБота.Получить()) Тогда
		Возврат expert1cПорталЗаявок.Ошибка(503, "Вход через MAX пока не настроен.");
	КонецЕсли;

	Код = НовыйСлучайныйКод();
	Опрос = НовыйСлучайныйКод();
	ПроверочныйКод = Формат(Новый ГенераторСлучайныхЧисел().СлучайноеЧисло(1000, 9999), "ЧГ=0");

	Состояние = Новый Структура;
	Состояние.Вставить("Цель", Цель);
	Состояние.Вставить("Участник", Участник);
	Состояние.Вставить("ПроверочныйКод", ПроверочныйКод);
	Состояние.Вставить("ХешОпроса", ХешСтроки(Опрос));
	Состояние.Вставить("Создан", ТекущаяДатаСеанса());
	Состояние.Вставить("Этап", "ожидание_старта");
	Состояние.Вставить("МаксИд", "");
	Состояние.Вставить("Имя", "");
	Состояние.Вставить("Попытки", 0);
	СохранитьСостояние(Код, Состояние);

	Данные = Новый Структура;
	Данные.Вставить("link", "https://max.ru/" + Ник + "?start=" + Код);
	Данные.Вставить("code", Код);
	Данные.Вставить("poll", Опрос);
	Данные.Вставить("verify", ПроверочныйКод);
	Возврат expert1cПорталЗаявок.Ответ(200, Данные);

КонецФункции

// Опрашивает состояние входа. Когда пользователь подтвердил вход в боте, открывает сессию (или привязывает аккаунт).
//
// Параметры:
//  Код - Строка - код из ссылки на бота
//  Опрос - Строка - секрет опроса, известный только странице, начавшей вход
//
// Возвращаемое значение:
//  Структура - Код (Число), Данные (Структура: status = "ожидание" | "ok"; token, name, needOrganization - при входе)
//
Функция ОпросВхода(Знач Код, Знач Опрос) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Состояние = ПолучитьСостояние(Код);
	Если Состояние = Неопределено Тогда
		Возврат expert1cПорталЗаявок.Ошибка(410, "Время ожидания истекло. Начните вход заново.");
	КонецЕсли;
	Если Состояние.ХешОпроса <> ХешСтроки(Опрос) Тогда
		Возврат expert1cПорталЗаявок.Ошибка(404, "Вход не найден.");
	КонецЕсли;

	Если Состояние.Этап <> "подтверждено" Тогда
		Возврат expert1cПорталЗаявок.Ответ(200, Новый Структура("status,stage", "ожидание", Состояние.Этап));
	КонецЕсли;

	УдалитьСостояние(Код);

	Если Состояние.Цель = "привязка" Тогда
		Результат = expert1cПорталЗаявок.ПривязатьМакс(Состояние.Участник, Состояние.МаксИд);
		Если Результат.Код = 200 Тогда
			Результат.Данные = Новый Структура("status,linked", "ok", Истина);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Результат = expert1cПорталЗаявок.ВойтиЧерезМакс(Состояние.МаксИд, Состояние.Имя);
	Если Результат.Код = 200 Тогда
		Результат.Данные.Вставить("status", "ok");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет секрет вебхука из заголовка запроса MAX.
//
// Параметры:
//  Секрет - Строка - значение заголовка X-Max-Bot-Api-Secret
//
// Возвращаемое значение:
//  Булево - Истина, если секрет задан и совпадает
//
Функция СекретВебхукаВерен(Знач Секрет) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Ожидаемый = Константы.expert1cМаксСекретВебхука.Получить();
	Возврат НЕ ПустаяСтрока(Ожидаемый) И Секрет = Ожидаемый;

КонецФункции

// Обрабатывает событие от MAX (вебхук).
//
// Параметры:
//  Событие - Соответствие - разобранный JSON события
//
Процедура ОбработатьСобытие(Событие) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТипСобытия = Событие.Получить("update_type");
	Если ТипСобытия = "bot_started" Тогда
		ОбработатьСтарт(Событие);
	ИначеЕсли ТипСобытия = "message_created" Тогда
		ОбработатьСообщение(Событие);
	КонецЕсли;

КонецПроцедуры

// Отправляет участнику портала сообщение в MAX, если к его заявке изменился статус.
// Ошибки отправки не прерывают запись заявки.
//
// Параметры:
//  Заявка - ЗадачаСсылка.ЗаявкаНаВыполнение - измененная заявка
//  Изменения - Структура - ЕстьИзменения, Статус (см. ПриЗаписи в модуле объекта задачи)
//
Процедура УведомитьОСтатусеЗаявки(Заявка, Изменения) Экспорт

	Попытка
		Если НЕ Изменения.ЕстьИзменения ИЛИ НЕ ЗначениеЗаполнено(Изменения.Статус) Тогда
			Возврат;
		КонецЕсли;

		УстановитьПривилегированныйРежим(Истина);

		МаксИд = МаксИдИнициатора(Заявка.АдресацияИнициатор);
		Если ПустаяСтрока(МаксИд) Тогда
			Возврат;
		КонецЕсли;

		Статус = ?(Заявка.Выполнена, "Выполнена", Строка(Изменения.Статус));
		ОтправитьСообщение(МаксИд, "Заявка " + Заявка.Номер + " """ + Заявка.Тема + """: статус изменен на """ + Статус + """.");
	Исключение
		ЗаписьЖурналаРегистрации("Портал заявок. MAX", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработкаСобытий

Процедура ОбработатьСтарт(Событие)

	МаксИд = МаксИдИзСоставногоПоля(Событие.Получить("user"));
	Если ПустаяСтрока(МаксИд) Тогда
		Возврат;
	КонецЕсли;

	Код = Событие.Получить("payload");
	Состояние = ?(ТипЗнч(Код) = Тип("Строка"), ПолучитьСостояние(Код), Неопределено);

	Если Состояние = Неопределено Тогда
		ОтправитьСообщение(МаксИд, "Чтобы войти на портал заявок, откройте портал в браузере и нажмите ""Войти через MAX"". "
			+ "Ссылка для входа действует 10 минут.");
		Возврат;
	КонецЕсли;

	Состояние.МаксИд = МаксИд;
	Состояние.Имя = ИмяИзСоставногоПоля(Событие.Получить("user"));
	Состояние.Этап = "ожидание_кода";
	СохранитьСостояние(Код, Состояние);
	// Какой вход ждет проверочный код от этого пользователя MAX.
	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), "ожидает_" + МаксИд, Код);

	ОтправитьСообщение(МаксИд, "Здравствуйте" + ?(ПустаяСтрока(Состояние.Имя), "", ", " + Состояние.Имя) + "! "
		+ "Чтобы подтвердить вход на портал заявок, отправьте мне в ответ четыре цифры, показанные на странице портала.");

КонецПроцедуры

Процедура ОбработатьСообщение(Событие)

	Сообщение = Событие.Получить("message");
	Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Отправитель = Сообщение.Получить("sender");
	МаксИд = МаксИдИзСоставногоПоля(Отправитель);
	Если ПустаяСтрока(МаксИд) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Отправитель) = Тип("Соответствие") И Отправитель.Получить("is_bot") = Истина Тогда
		Возврат;
	КонецЕсли;

	Тело = Сообщение.Получить("body");
	Текст = "";
	Если ТипЗнч(Тело) = Тип("Соответствие") И ТипЗнч(Тело.Получить("text")) = Тип("Строка") Тогда
		Текст = СокрЛП(Тело.Получить("text"));
	КонецЕсли;

	Код = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), "ожидает_" + МаксИд);
	Состояние = ?(ТипЗнч(Код) = Тип("Строка"), ПолучитьСостояние(Код), Неопределено);
	Если Состояние = Неопределено ИЛИ Состояние.Этап <> "ожидание_кода" Тогда
		ОтправитьСообщение(МаксИд, "Чтобы войти на портал заявок, откройте портал в браузере и нажмите ""Войти через MAX"".");
		Возврат;
	КонецЕсли;

	Если Текст = Состояние.ПроверочныйКод Тогда
		Состояние.Этап = "подтверждено";
		СохранитьСостояние(Код, Состояние);
		ХранилищеОбщихНастроек.Удалить(КлючОбъектаНастроек(), "ожидает_" + МаксИд, Неопределено);
		ОтправитьСообщение(МаксИд, "Вход подтвержден. Вернитесь на страницу портала заявок.");
		Возврат;
	КонецЕсли;

	Состояние.Попытки = Состояние.Попытки + 1;
	Если Состояние.Попытки >= 5 Тогда
		УдалитьСостояние(Код);
		ХранилищеОбщихНастроек.Удалить(КлючОбъектаНастроек(), "ожидает_" + МаксИд, Неопределено);
		ОтправитьСообщение(МаксИд, "Слишком много неверных попыток. Начните вход на портале заново.");
		Возврат;
	КонецЕсли;
	СохранитьСостояние(Код, Состояние);
	ОтправитьСообщение(МаксИд, "Код не подошел. Отправьте четыре цифры, показанные на странице портала.");

КонецПроцедуры

#КонецОбласти

#Область Состояние

Функция КлючОбъектаНастроек()

	Возврат "expert1cПорталМакс";

КонецФункции

Процедура СохранитьСостояние(Код, Состояние)

	ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), "вход_" + ХешСтроки(Код), Состояние);

КонецПроцедуры

// Возвращает состояние входа или Неопределено, если кода нет или он просрочен (10 минут).
Функция ПолучитьСостояние(Код)

	Если ПустаяСтрока(Код) ИЛИ СтрДлина(Код) > 100 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Состояние = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), "вход_" + ХешСтроки(Код));
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТекущаяДатаСеанса() > Состояние.Создан + 600 Тогда
		УдалитьСостояние(Код);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Состояние;

КонецФункции

Процедура УдалитьСостояние(Код)

	ХранилищеОбщихНастроек.Удалить(КлючОбъектаНастроек(), "вход_" + ХешСтроки(Код), Неопределено);

КонецПроцедуры

#КонецОбласти

#Область MAX

// Отправляет сообщение пользователю MAX от имени бота. Токен берется из константы.
Процедура ОтправитьСообщение(МаксИд, Текст)

	Токен = Константы.expert1cМаксТокенБота.Получить();
	Если ПустаяСтрока(Токен) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Новый Структура("text", Текст));

		Запрос = Новый HTTPЗапрос("/messages?user_id=" + МаксИд);
		Запрос.Заголовки.Вставить("Authorization", Токен);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

		Соединение = Новый HTTPСоединение("platform-api.max.ru", 443, , , , 20, Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Если Ответ.КодСостояния >= 300 Тогда
			ЗаписьЖурналаРегистрации("Портал заявок. MAX", УровеньЖурналаРегистрации.Предупреждение, , ,
				"Не удалось отправить сообщение в MAX. Код ответа " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли;
	Исключение
		// Токен в текст ошибки не попадает: он передается только в заголовке.
		ЗаписьЖурналаРегистрации("Портал заявок. MAX", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Идентификатор пользователя MAX из составного поля события: user (bot_started) или sender (message_created).
Функция МаксИдИзСоставногоПоля(Поле)

	Если ТипЗнч(Поле) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Поле.Получить("user_id");
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ИмяИзСоставногоПоля(Поле)

	Если ТипЗнч(Поле) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Имя = Поле.Получить("name");
	Если ТипЗнч(Имя) = Тип("Строка") И НЕ ПустаяСтрока(Имя) Тогда
		Возврат СокрЛП(Имя);
	КонецЕсли;

	Результат = "";
	Для Каждого Ключ Из СтрРазделить("first_name,last_name", ",") Цикл
		Значение = Поле.Получить(Ключ);
		Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда
			Результат = СокрЛП(Результат + " " + Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МаксИдИнициатора(Адресат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Участники.МаксИд КАК МаксИд
	|ИЗ
	|	Справочник.expert1cУчастникиПортала КАК Участники
	|ГДЕ
	|	Участники.Адресат = &Адресат
	|	И Участники.МаксИд <> """"
	|	И НЕ Участники.ПометкаУдаления";
	Запрос.УстановитьПараметр("Адресат", Адресат);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.МаксИд, "");

КонецФункции

#КонецОбласти

Функция НовыйСлучайныйКод()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")
		+ СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

КонецФункции

Функция ХешСтроки(Значение)

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Значение);
	Возврат СтрЗаменить(Строка(Хеш.ХешСумма), " ", "");

КонецФункции

#КонецОбласти
