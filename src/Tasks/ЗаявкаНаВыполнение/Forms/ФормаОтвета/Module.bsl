
&НаКлиенте
Процедура Отправить(Команда)
	МассивВложений = Новый Массив;
	СчетчикСкриншотов = 1;
	
	Для Каждого СтрокаДанных Из ПриВставкеИзБуфераОбменаДанные Цикл
		Если ЗначениеЗаполнено(СтрокаДанных.АдресКартинки) Тогда
			ИмяФайла = "Скриншот_" + СокрЛП(СчетчикСкриншотов) + ".png";
			СчетчикСкриншотов = СчетчикСкриншотов + 1;
			
			СтруктураВложения = Новый Структура;
			СтруктураВложения.Вставить("АдресВХ", СтрокаДанных.АдресКартинки);
			СтруктураВложения.Вставить("ИмяФайла", ИмяФайла);
			МассивВложений.Добавить(СтруктураВложения);
		ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ПолноеИмяФайла) Тогда
			ИмяФайла = СтрокаДанных.ПолноеИмяФайла;
			ИндексРазделителя = СтрНайти(ИмяФайла, "\", НаправлениеПоиска.Сконца);
			Если ИндексРазделителя = 0 Тогда
				ИндексРазделителя = СтрНайти(ИмяФайла, "/", НаправлениеПоиска.Сконца);
			КонецЕсли;
			Если ИндексРазделителя > 0 Тогда
				ИмяФайла = Сред(ИмяФайла, ИндексРазделителя + 1);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаДанных.АдресКартинки) Тогда
				АдресВХ = СтрокаДанных.АдресКартинки;
			Иначе
				АдресВХ = Неопределено;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(АдресВХ) Тогда
				СтруктураВложения = Новый Структура;
				СтруктураВложения.Вставить("АдресВХ", АдресВХ);
				СтруктураВложения.Вставить("ИмяФайла", ИмяФайла);
				МассивВложений.Добавить(СтруктураВложения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстОтвета", СокрЛП(ТекстОтвета));
	Результат.Вставить("МассивВложений", МассивВложений);
	
	Закрыть(Результат);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//ТекстОтвета = Символы.ПС + СокрЛП(Справочники.ШаблоныТекстовПисем.ПолучитьТекстШаблона(ВстроеннаяПочтаСерверПовтИсп.ПолучитьПерсональнуюНастройку("ПодписьДляНовыхПисем")));
	ТекстОтвета = Символы.ПС + СокрЛП(ПараметрыСеанса.ТекущийПользователь.Комментарий);
КонецПроцедуры            


&НаКлиенте
Процедура ПриВставкеИзБуфераОбмена(Значение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;

	ТекущийТекст = ТекстОтвета;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Коллекция = Значение;
	Иначе
		Коллекция = Новый Массив;
		Коллекция.Добавить(Значение);
	КонецЕсли;
	
	ЕстьКартинкаИлиФайл = Ложь;
	
	Для Каждого Элемент Из Коллекция Цикл
		
		ТипЭлемента = ТипЗнч(Элемент);
		
		Если ТипЭлемента = Тип("Картинка") Тогда
			ЕстьКартинкаИлиФайл = Истина;
			НоваяСтрока = ПриВставкеИзБуфераОбменаДанные.Добавить();
			НоваяСтрока.Тип = ТипЭлемента;
			НоваяСтрока.АдресКартинки = ПоместитьВоВременноеХранилище(Элемент, УникальныйИдентификатор);
		ИначеЕсли ТипЭлемента = Тип("СсылкаНаФайл") Тогда
			ЕстьКартинкаИлиФайл = Истина;
			НоваяСтрока = ПриВставкеИзБуфераОбменаДанные.Добавить();
			НоваяСтрока.Тип = ТипЭлемента;
			НоваяСтрока.ПолноеИмяФайла = Элемент.Файл.ПолноеИмя;
			ОбработатьФайлИзБуфераАсинх(Элемент, НоваяСтрока);
		ИначеЕсли ТипЭлемента = Тип("Строка") Тогда
			СтандартнаяОбработка = Истина;
		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЕстьКартинкаИлиФайл Тогда
		ТекстОтвета = ТекущийТекст;
		ОбновитьСписокВложенийНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВложенийНаСервере()
	
	СчетчикСкриншотов = 1;
	
	// Удаляем созданные ранее декорации списков файлов в группе "ГруппаВложения"
	МассивЭлементовДляУдаления = Новый Массив;
	Для Каждого ЭлементФормы Из Элементы.ГруппаВложения.ПодчиненныеЭлементы Цикл
		МассивЭлементовДляУдаления.Добавить(ЭлементФормы);
	КонецЦикла;
	Для Каждого ЭлементФормы Из МассивЭлементовДляУдаления Цикл
		Элементы.Удалить(ЭлементФормы);
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ПриВставкеИзБуфераОбменаДанные Цикл
		ИмяФайла = "";
		Если ЗначениеЗаполнено(СтрокаДанных.АдресКартинки) Тогда
			ИмяФайла = "Скриншот_" + СокрЛП(СчетчикСкриншотов) + ".png";
			СчетчикСкриншотов = СчетчикСкриншотов + 1;
		ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ПолноеИмяФайла) Тогда
			ИмяФайла = СтрокаДанных.ПолноеИмяФайла;
			ИндексРазделителя = СтрНайти(ИмяФайла, "\", НаправлениеПоиска.Сконца);
			Если ИндексРазделителя = 0 Тогда
				ИндексРазделителя = СтрНайти(ИмяФайла, "/", НаправлениеПоиска.Сконца);
			КонецЕсли;
			Если ИндексРазделителя > 0 Тогда
				ИмяФайла = Сред(ИмяФайла, ИндексРазделителя + 1);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяФайла) Тогда
			ИмяЭлемента = "ГиперссылкаВложения_" + СокрЛП(СтрокаДанных.ПолучитьИдентификатор());
			ЭлементСсылка = Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), Элементы.ГруппаВложения);
			ЭлементСсылка.Вид = ВидДекорацииФормы.Надпись;
			ЭлементСсылка.Заголовок = ИмяФайла;
			ЭлементСсылка.Гиперссылка = Истина;
			ЭлементСсылка.АвтоМаксимальнаяШирина = Истина;
			ЭлементСсылка.УстановитьДействие("Нажатие", "НажатиеНаГиперссылкуВложения");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НажатиеНаГиперссылкуВложения(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	Префикс = "ГиперссылкаВложения_";
	Если СтрНачинаетсяС(ИмяЭлемента, Префикс) Тогда
		ИдентификаторCтроки = Число(Сред(ИмяЭлемента, СтрДлина(Префикс) + 1));
		СтрокаДанных = ПриВставкеИзБуфераОбменаДанные.НайтиПоИдентификатору(ИдентификаторCтроки);
		Если СтрокаДанных <> Неопределено Тогда
			Если ЗначениеЗаполнено(СтрокаДанных.АдресКартинки) Тогда
				ИмяФайла = Элемент.Заголовок;
				ФайловаяСистемаКлиент.ОткрытьФайл(СтрокаДанных.АдресКартинки, , ИмяФайла);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОбработатьФайлИзБуфераАсинх(СсылкаНаФайлОбъект, НоваяСтрока)
	НоваяСтрока.СодержимоеФайла = Ждать СсылкаНаФайлОбъект.ПолучитьКакСтрокуАсинх();
	ДвоичныеДанныеФайла = Ждать СсылкаНаФайлОбъект.ПолучитьКакДвоичныеДанныеАсинх();
	Если ДвоичныеДанныеФайла <> Неопределено Тогда
		НоваяСтрока.ДвоичныеДанные = ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанныеФайла);
		НоваяСтрока.АдресКартинки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, УникальныйИдентификатор);
		ОбновитьСписокВложенийНаСервере();
	КонецЕсли;
КонецПроцедуры
