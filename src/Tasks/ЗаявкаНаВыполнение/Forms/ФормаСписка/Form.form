	ЗадачаЗаявкаНаВыполнение.Ссылка В
			(ВЫБРАТЬ
				З.Ссылка
			ИЗ
				Задача.ЗаявкаНаВыполнение КАК З
					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АдресацияЗаявокНаВыполнение КАК А
					ПО
						(З.АдресацияКонтрагент = А.Контрагент
							ИЛИ А.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
							И (З.АдресацияИнициатор = А.Инициатор
								ИЛИ А.Инициатор = ЗНАЧЕНИЕ(Справочник.АдресатыПочтовыхСообщений.ПустаяСсылка))
							И (З.АдресацияИсполнитель = А.Исполнитель
								ИЛИ А.Исполнитель = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
							И А.ТекущийПользователь = &amp;ТекущийПользователь)</queryText>
      <mainTable>Task.ЗаявкаНаВыполнение</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <parameters>
    <name>ТекущийПользователь</name>
    <valueType>
      <types>CatalogRef.Пользователи</types>
    </valueType>
  </parameters>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
  <extInfo xsi:type="form:DynamicListFormExtInfo"/>
</form:Form>
