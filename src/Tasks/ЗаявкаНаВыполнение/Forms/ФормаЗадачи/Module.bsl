&НаСервере
Процедура ОбновитьПисьма()
	
	Дерево = РеквизитФормыВЗначение("Письма");
	Дерево.Строки.Очистить();
	Сч = 1;
	Для каждого Стр из Объект.Письма Цикл
		
		НоваяСтрокаПисьмо = Дерево.Строки.Добавить();
		НоваяСтрокаПисьмо.НомерСтроки = Сч;
		НоваяСтрокаПисьмо.Письмо = Стр.Письмо;
		НоваяСтрокаПисьмо.ИндексКартинки = 0;
		НоваяСтрокаПисьмо.ИндексКартинкиФайл = -1;
		Если ЗначениеЗаполнено(Стр.Письмо) Тогда
			ФайлыПисьма = ВстроеннаяПочтаСервер.ПолучитьФайлыПисьма(
				Стр.Письмо, // Письмо
				Истина, // ФормироватьРазмерПредставление
				ОтображатьУдаленныеФайлы); // ВключатьПомеченныеНаУдаление
			
			Для каждого ФайлыПисьмаСтрока Из ФайлыПисьма Цикл
                Если ФайлыПисьмаСтрока.Размер > 5000 Тогда
					НоваяСтрокаФайл = НоваяСтрокаПисьмо.Строки.Добавить();
					НоваяСтрокаФайл.Письмо = ФайлыПисьмаСтрока.Представление;
					НоваяСтрокаФайл.Файл = ФайлыПисьмаСтрока.Ссылка;
					НоваяСтрокаФайл.ИндексКартинки = -1;
					НоваяСтрокаФайл.ИндексКартинкиФайл = ФайлыПисьмаСтрока.ИндексКартинки;
					Если ФайлыПисьмаСтрока.ПометкаУдаления Тогда
						НоваяСтрокаФайл.ИндексКартинкиФайл = НоваяСтрокаФайл.ИндексКартинкиФайл + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		
		НоваяСтрокаТекст = НоваяСтрокаПисьмо.Строки.Добавить();
		ТекстПисьма = Стр.Письмо.ТекстПисьмаПростойТекстХранилище.Получить();
		КонецОтвета = Найти(ТекстПисьма,"-----Original Message-----");
		Если КонецОтвета > 0 Тогда 
			ТекстПисьма = Лев(ТекстПисьма,КонецОтвета - 1);
		КонецЕсли;	
		НоваяСтрокаТекст.Письмо = ТекстПисьма;
		НоваяСтрокаТекст.ИндексКартинки = -1;
		НоваяСтрокаТекст.ИндексКартинкиФайл = -1;
		Сч = Сч + 1;
		
	КонецЦикла;	
	ЗначениеВРеквизитФормы(Дерево, "Письма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПисьмаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Не ПолныеПрава() Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Элементы.Письма.ТекущиеДанные.Письмо) = Тип("ДокументСсылка.ВходящееПисьмо") Тогда
		ПараметрыФормы = Новый Структура("Ключ", Элементы.Письма.ТекущиеДанные.Письмо);
		ОткрытьФорму("Документ.ВходящееПисьмо.ФормаОбъекта",ПараметрыФормы);
	ИначеЕсли ЗначениеЗаполнено(Элементы.Письма.ТекущиеДанные.Файл) Тогда
		ОткрытьВложение(Элементы.Письма.ТекущиеДанные.Файл);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура Ответить(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;	 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьТекстЗавершение", ЭтотОбъект);
	ОткрытьФорму("Задача.ЗаявкаНаВыполнение.Форма.ФормаОтвета", , , , , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры   

&НаКлиенте
Процедура ДобавитьТекстЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(РезультатЗакрытия) = Тип("Структура") Тогда
		ТекстОтвета = РезультатЗакрытия.ТекстОтвета;
		МассивВложений = РезультатЗакрытия.МассивВложений;
		Если ЗначениеЗаполнено(ТекстОтвета) Или МассивВложений.Количество() > 0 Тогда
			ОтветитьНаСервере(ТекстОтвета, МассивВложений);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		ОтветитьНаСервере(Строка(РезультатЗакрытия), Новый Массив);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьПараметрыЗаполненияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Сообщение = Новый СообщениеПользователю;
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Сообщение.Текст = "В форме нажата стандартная кнопка ОК";
	ИначеЕсли Результат = КодВозвратаДиалога.Пропустить Тогда
		Сообщение.Текст = "В форме нажата стандартная кнопка Пропустить";
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена Тогда
		Сообщение.Текст = "В форме нажата стандартная кнопка Отмена";
	Иначе       
		Сообщение.Текст = "Обработка этой команды в форме не предусмотрена";
	КонецЕсли;
	Сообщение.Сообщить();   
КонецПроцедуры

&НаСервере
Процедура ОтветитьНаСервере(ТекстОтвета, МассивВложений = Неопределено)
	УчетнаяЗапись = Константы.УчетнаяЗаписьПоддержки.Получить();
	
	ПапкаВходящие = РегистрыСведений.ПапкиУчетныхЗаписей.ПолучитьПапку(
		УчетнаяЗапись,
		Перечисления.ВидыПапокПисем.Входящие);
		
	ОтправительАдресат = млкПодпискиНаСобытия.ПолучитьАдресат(ПараметрыСеанса.ТекущийПользователь);
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Сообщить("Не заполнена учетная запись для ответа");
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(ПапкаВходящие) Тогда
		Сообщить("Не заполнена папка входящих писем в учетной записи");
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(ОтправительАдресат) Тогда
		Сообщить("Не заполнен адресат текущего пользователя");
		Возврат;
	КонецЕсли;	
	
	ВходящееПисьмо = Документы.ВходящееПисьмо.СоздатьДокумент();
	ВходящееПисьмо.Важность = Перечисления.ВажностьПисем.Обычная;
	ВходящееПисьмо.ВидМаршрутизации = Перечисления.ВидыМаршрутизацииПисем.Внешняя;
	ВходящееПисьмо.Дата = ТекущаяДата();
	ВходящееПисьмо.ДатаОтправки = ТекущаяДата();
	ВходящееПисьмо.ДатаПолучения = ТекущаяДата();
	ВходящееПисьмо.Комментарий = "Ответ создан в заявке на выполнение " + Объект.Номер + " от " + Объект.Дата;
	ВходящееПисьмо.ОтправительАдресат = ОтправительАдресат;
	ВходящееПисьмо.Папка = ПапкаВходящие;
	ВходящееПисьмо.УчетнаяЗапись = УчетнаяЗапись;
	ВходящееПисьмо.Тема = "RE: " + Объект.Тема + " [#" + Объект.Номер + "]";
	ВходящееПисьмо.ТипТекста = Перечисления.ТипыТекстовПочтовыхСообщений.ПростойТекст;
	ВходящееПисьмо.ТекстПисьмаПростойТекстХранилище = Новый ХранилищеЗначения(ТекстОтвета);
	НоваяСтрока = ВходящееПисьмо.ПолучателиПисьма.Добавить();
	НоваяСтрока.Адресат = Константы.АдресатСистемыПоддержки.Получить();
	
	ВходящееПисьмо.Записать();
	
	Если МассивВложений <> Неопределено Тогда
		Для Каждого Вложение Из МассивВложений Цикл
			АдресВХ = Вложение.АдресВХ;
			ИмяФайла = Вложение.ИмяФайла;
			Если ЗначениеЗаполнено(АдресВХ) И ЭтоАдресВременногоХранилища(АдресВХ) Тогда
				ИмяФайлаИнфо = РаботаСоСтроками.РазложитьИмяФайла(ИмяФайла);
				
				ДвоичныеДанныеВложения = ПолучитьИзВременногоХранилища(АдресВХ);
				РазмерФайла = 0;
				Если ТипЗнч(ДвоичныеДанныеВложения) = Тип("ДвоичныеДанные") Тогда
					РазмерФайла = ДвоичныеДанныеВложения.Размер();
				ИначеЕсли ТипЗнч(ДвоичныеДанныеВложения) = Тип("Картинка") Тогда
					ДвоичныеДанныеКартинки = ДвоичныеДанныеВложения.ПолучитьДвоичныеДанные();
					Если ТипЗнч(ДвоичныеДанныеКартинки) = Тип("ДвоичныеДанные") Тогда
						РазмерФайла = ДвоичныеДанныеКартинки.Размер();
						АдресВХ = ПоместитьВоВременноеХранилище(ДвоичныеДанныеКартинки, УникальныйИдентификатор);
					КонецЕсли;
				КонецЕсли;
				
				СведенияОФайле = РаботаСФайламиКлиентСервер.СведенияОФайле("ФайлСВерсией");
				СведенияОФайле.АдресВременногоХранилищаФайла = АдресВХ;
				СведенияОФайле.ИмяБезРасширения = ИмяФайлаИнфо.Имя;
				СведенияОФайле.РасширениеБезТочки = ИмяФайлаИнфо.Расширение;
				СведенияОФайле.Размер = РазмерФайла;
				СведенияОФайле.ВремяИзменения = ТекущаяДатаСеанса();
				СведенияОФайле.ВремяИзмененияУниверсальное = РаботаСФайламиКлиентСервер.ПолучитьУниверсальноеВремя(СведенияОФайле.ВремяИзменения);
				СведенияОФайле.ХранитьВерсии = Ложь;
				
				РаботаСФайламиВызовСервера.СоздатьФайлСВерсией(ВходящееПисьмо.Ссылка, СведенияОФайле);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//млкПодпискиНаСобытия.ДокументВходящееПисьмоПриЗаписиПриЗаписи(ВходящееПисьмо.Ссылка, Ложь);
	
	Прочитать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолныеПрава()
	Возврат РольДоступна("ПолныеПрава");
КонецФункции


