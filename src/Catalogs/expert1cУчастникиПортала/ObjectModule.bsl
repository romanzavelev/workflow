// expert1c 03.10.2026 Портал заявок: при выборе контрагента в карточке участника заполняем его в заявках участника

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ДополнительныеСвойства.Вставить("КонтрагентИзменился",
		ЗначениеЗаполнено(Контрагент) И (ЭтоНовый() ИЛИ Ссылка.Контрагент <> Контрагент));

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка ИЛИ Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеСвойства.Свойство("КонтрагентИзменился") И ДополнительныеСвойства.КонтрагентИзменился Тогда
		expert1cПорталЗаявок.ПривязатьЗаявкиКонтрагента(Адресат, Контрагент);
	КонецЕсли;

КонецПроцедуры
